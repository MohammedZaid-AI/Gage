# Gage configuration. Copy to .env and adjust as needed.

# SQLAlchemy database URL
DATABASE_URL=sqlite:///./storage/observations.db

# LLM provider: mock | groq | sarvam_finetuned
LLM_PROVIDER=groq

# Fine-tuned Sarvam-1 (LLM_PROVIDER=sarvam_finetuned): LoRA adapter on the base
# model. Loaded on the first chat request that asks for it (never at startup); if
# the adapter or GPU is missing that request gets a clear 503, never a Groq answer.
# A request can pick its engine: POST /chat {"provider": "groq" | "sarvam_finetuned"}.
SARVAM_BASE_MODEL=sarvamai/sarvam-1
SARVAM_ADAPTER_PATH=./models/sarvam_agri_final
SARVAM_DEVICE=auto
SARVAM_QUANTIZATION=4bit
SARVAM_MAX_NEW_TOKENS=256

# Retrieval over knowledge_base/ (Kannada questions are translated via Sarvam first)
KNOWLEDGE_BASE_DIR=./knowledge_base
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RETRIEVAL_MIN_SCORE=0.83

# AI farm summary: on a new alert, or at most this often from sensor data
SUMMARY_INTERVAL_MINUTES=60

# Groq (OpenAI-compatible endpoint) — used when LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Query rewrite + fact check (own per-model rate limit); token budget per model
GROQ_HELPER_MODEL=openai/gpt-oss-20b
GROQ_TOKENS_PER_MINUTE=8000

# Speech: STT + TTS. mock | sarvam
SPEECH_PROVIDER=mock
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=kavitha

# Where uploaded images are stored
IMAGE_DIR=./storage/images

# Auth — REQUIRED. The app refuses to start without a long random secret.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# Local demo only: seed a demo farmer (phone 9999999999 / password demo1234),
# farm and node (key demo-node-key-123) on startup. Never enable in production.
SEED_DEMO=false

# Secret for hashing node API keys at rest (HMAC-SHA256). Optional: derived
# from JWT_SECRET if empty, but set it so JWT_SECRET can rotate independently.
NODE_KEY_SECRET=

# Gage configuration. Copy to .env and adjust as needed.

# SQLAlchemy database URL
DATABASE_URL=sqlite:///./storage/observations.db

# AI providers. VISION: mock. LLM: mock | groq
VISION_PROVIDER=mock
LLM_PROVIDER=groq

# Groq (OpenAI-compatible endpoint) — used when LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=gpt-oss-120b

# Other keys (only needed for future providers)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Where uploaded images are stored
IMAGE_DIR=./storage/images

# Gage configuration. Copy to .env and adjust as needed.

# SQLAlchemy database URL
DATABASE_URL=sqlite:///./storage/observations.db

# AI providers. VISION: mock | tflite. LLM: mock | groq
VISION_PROVIDER=tflite
LLM_PROVIDER=groq

# Groq (OpenAI-compatible endpoint) — used when LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Speech: STT + TTS. mock | sarvam
SPEECH_PROVIDER=mock
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_SPEAKER=anushka

# Other keys (only needed for future providers)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Sugarcane disease classifier (VISION_PROVIDER=tflite)
VISION_MODEL_PATH=./models/sugarcane/model_unquant.tflite
VISION_LABELS_PATH=./models/sugarcane/labels.txt
# Below this top-1 probability Gage refuses to name a class
VISION_CONFIDENCE_THRESHOLD=0.70
# Top-1 must also beat top-2 by this much
VISION_MARGIN_MIN=0.15

# Where uploaded images are stored
IMAGE_DIR=./storage/images

# Auth — MUST be a long random string in production
JWT_SECRET=dev-insecure-change-me
JWT_EXPIRE_MINUTES=10080

# Seed a demo farmer/farm/node on startup (dashboard works out of the box)
SEED_DEMO=true
